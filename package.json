{
  "name": "saif-aljanahi-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run seo:generate && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "build:production": "npm run build",
    "build:ci": "npm install --legacy-peer-deps && npm run build",
    "deploy:preview": "npm run build:production && echo 'Build complete! Upload dist/ folder to Cloudflare Pages'",
    "verify:images": "node scripts/verify-blog-images.cjs",
    "thumbs": "node scripts/thumbs.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.cjs",
    "seo:rss": "node scripts/generate-rss.cjs",
    "seo:generate": "npm run seo:sitemap && npm run seo:rss",
    "lint:oxlint": "oxlint -c .oxlintrc.json",
    "insights": "node scripts/insights.mjs"
  },
  "dependencies": {
    "@shikijs/langs": "^3.6.0",
    "@shikijs/themes": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.4",
    "react-router-dom": "^6.26.1",
    "shiki": "^3.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@oxlint/plugins": "1.82.0",
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^3.2.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "oxlint": "1.82.0",
    "terser": "^5.42.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^3.2.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.52.5"
  }
}
