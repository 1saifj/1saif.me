# Cloudflare Pages joins the values when two matching rules set the same header,
# so every header is set by exactly one rule. HTML has no Cache-Control rule: Pages
# then serves it with "max-age=0, must-revalidate", so a deploy shows up at once.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # prerender.mjs fills script-src with the hash of every inline script it writes.
  Content-Security-Policy: default-src 'self'; script-src __SCRIPT_HASHES__ 'strict-dynamic' https: 'unsafe-inline'; worker-src 'self'; object-src 'none'; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; require-trusted-types-for 'script'

# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts get a year: rename the file whenever its contents change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons keep their names when they change, so they get a week.

/*.jpg
  Cache-Control: public, max-age=604800

/*.jpeg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

# Service worker kill switch: always revalidate so old installs pick it up.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600

/atom.xml
  Cache-Control: public, max-age=3600

/feed.json
  Cache-Control: public, max-age=3600
